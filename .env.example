# ==============================================================================
# MediExplain AI — Unified Environment Configuration Reference
# ==============================================================================
# Copy this file to .env in backend/ and to .env.local in frontend/
# NEVER commit populated .env files to version control or repositories.

# ==============================================================================
# 1. FRONTEND ENVIRONMENT (frontend/.env.local)
# Safe to expose in client-side code (prefixed with NEXT_PUBLIC_)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key_id

# ==============================================================================
# 2. BACKEND ENVIRONMENT (backend/.env)
# STRICTLY SECRET — NEVER EXPOSE TO FRONTEND OR BROWSER
# ==============================================================================
# Supabase Database & Private Storage Access
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Google Gemini AI (Medical Report Explanation)
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.8-flash

# Razorpay Subscriptions & Webhook Processing (TEST MODE FIRST)
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret
RAZORPAY_PLAN_ID=plan_your_plan_id_created_in_dashboard

# Application Server Settings
APP_ENV=development
BACKEND_SECRET_KEY=generate-a-secure-random-64-character-string
ALLOWED_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Kolkata
MAX_UPLOAD_SIZE_MB=20
ADMIN_EMAIL=admin@mediexplain.ai

