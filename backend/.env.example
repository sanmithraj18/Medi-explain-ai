# MediExplain AI — Backend Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ─── Supabase (Server-side Admin) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ─── Razorpay (TEST MODE FIRST) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# ─── App Configuration ────────────────────────────────────────────────────────
APP_ENV=development
BACKEND_SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALLOWED_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Kolkata
MAX_UPLOAD_SIZE_MB=20
ADMIN_EMAIL=

